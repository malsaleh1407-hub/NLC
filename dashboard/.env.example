# ============================================================================
# NLC Digital Performance Dashboard — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local (already gitignored).
# ============================================================================

# --- Google Business Profile Performance API (see GBP-SETUP.md) -------------
# OAuth client credentials from Google Cloud Console (Web application type).
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
# Long-lived refresh token for the Google account that OWNS the NLC profile,
# authorized with scope https://www.googleapis.com/auth/business.manage
GBP_REFRESH_TOKEN=
# Numeric location id — the XXXXXXXXXX part of "locations/XXXXXXXXXX".
GBP_LOCATION_ID=
# Display label shown in the dashboard header for this location.
GBP_LOCATION_LABEL="NLC — Factory#2, 106, Dammam"
