{
  "name": "nlc-brand-videos",
  "version": "1.0.0",
  "private": true,
  "description": "NLC (National Lighting Company) programmatic brand videos built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render:youtube": "remotion render src/index.ts YouTubeCommercial out/nlc-youtube-commercial.mp4",
    "render:reel": "remotion render src/index.ts InstagramReel out/nlc-instagram-reel.mp4",
    "render:square": "remotion render src/index.ts InstagramPost out/nlc-instagram-post.mp4",
    "render:linkedin": "remotion render src/index.ts LinkedInPost out/nlc-linkedin-post.mp4",
    "render:all": "npm run render:youtube && npm run render:reel && npm run render:square && npm run render:linkedin"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.242"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.242",
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
